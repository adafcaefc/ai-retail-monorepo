# Copy to .env and fill in values before running locally.
# Required for the backend to start and for agents to call Azure OpenAI.

# PostgreSQL connection string (SQLAlchemy + psycopg).
# The retail boards, the agents, `chat.*` and `retail.formula` all live in one
# database: `ai-retail-pg-db`. The prefix may be `postgresql://` — `db.py`
# rewrites it to `postgresql+psycopg://`. Azure Postgres needs sslmode=require.
DATABASE_URL=postgresql://user:password@ai-finance-forum-pg-server.postgres.database.azure.com:5432/ai-retail-pg-db?sslmode=require
# Local alternative, matching docker-compose.yml:
# DATABASE_URL=postgresql+psycopg://retail:devonly@localhost:5432/ai_retail

# Azure OpenAI — at least one of API_BASE or ENDPOINT is required
AZURE_OPENAI_API_BASE=https://your-resource.openai.azure.com
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# HTTP server port (default: 8000)
# PORT=8000

# Root log level (default: INFO). DEBUG adds a line per Azure OpenAI call
# with its status and remaining rate-limit headroom.
# LOG_LEVEL=INFO

# Workbook the Data Source page reads (default: the checked-in
# resources/Copy of AI_360_Retail_Dataset_v8.2_General_20260806.xlsx).
EXCEL_WORKBOOK_PATH=resources/Copy of AI_360_Retail_Dataset_v8.2_General_20260806.xlsx

# Phase 5 local CPU embedding profile (non-secret configuration).
# Azure SQL credentials remain in AZURE_SQL_CONNECTIONSTRING in the local .env.
RETAIL_EMBEDDING_PROFILE_KEY=local-bge-small-en-v1.5-384-v1
RETAIL_EMBEDDING_PROVIDER=local_sentence_transformers
RETAIL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETAIL_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RETAIL_EMBEDDING_DIMENSIONS=384
RETAIL_EMBEDDING_NORMALIZE=true
RETAIL_EMBEDDING_DEVICE=cpu
RETAIL_EMBEDDING_MAX_SEQUENCE_LENGTH=512
RETAIL_EMBEDDING_CHUNK_TARGET_TOKENS=384
RETAIL_EMBEDDING_CHUNK_OVERLAP_TOKENS=48

# Internal/dev-only Phase 6 evidence endpoint. This is not enterprise auth.
RETAIL_RETRIEVAL_API_ENABLED=false
