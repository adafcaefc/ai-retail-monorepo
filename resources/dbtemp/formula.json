{
    "version": 1,
    "formulas": [
        {
            "id": "f01-ads-per-store",
            "number": 1,
            "name": "ADS per store",
            "logic": "Base ADS × seasonality × archetype/horizon factor × store size × (1 + demand lever)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "base_ads * seasonality * arch_horizon_factor * store_size * (1 + demand_lever / 100) * IF(AND(promo_eligible = \"Y\", promo_lever > 0), 1 + (promo_lever / 100) * 1.3 * (1 - promo_depth), 1)",
            "parameters": [
                {
                    "key": "base_ads",
                    "label": "Base ADS",
                    "type": "number",
                    "default": 20.9096
                },
                {
                    "key": "seasonality",
                    "label": "Seasonality index",
                    "type": "number",
                    "default": 1.14
                },
                {
                    "key": "arch_horizon_factor",
                    "label": "Archetype/horizon factor (archHz)",
                    "type": "number",
                    "default": 0.9859
                },
                {
                    "key": "store_size",
                    "label": "Store size index",
                    "type": "number",
                    "default": 1.2236
                },
                {
                    "key": "demand_lever",
                    "label": "Demand lever %",
                    "type": "number",
                    "default": 0
                },
                {
                    "key": "promo_eligible",
                    "label": "Promo eligible (Y/N)",
                    "type": "text",
                    "default": "N"
                },
                {
                    "key": "promo_lever",
                    "label": "Promo lever %",
                    "type": "number",
                    "default": 0
                },
                {
                    "key": "promo_depth",
                    "label": "Promo depth",
                    "type": "number",
                    "default": 0.26
                }
            ]
        },
        {
            "id": "f02-on-hand",
            "number": 2,
            "name": "On-hand",
            "logic": "Base ADS × on-hand days × stock factor × store health × store size",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "base_ads * on_hand_days * stock_factor * store_health * store_size",
            "parameters": [
                {
                    "key": "base_ads",
                    "label": "Base ADS",
                    "type": "number",
                    "default": 20.9096
                },
                {
                    "key": "on_hand_days",
                    "label": "On-hand days",
                    "type": "number",
                    "default": 2.5
                },
                {
                    "key": "stock_factor",
                    "label": "Stock factor",
                    "type": "number",
                    "default": 1.03793
                },
                {
                    "key": "store_health",
                    "label": "Store health index",
                    "type": "number",
                    "default": 1.0061
                },
                {
                    "key": "store_size",
                    "label": "Store size index",
                    "type": "number",
                    "default": 1.2236
                }
            ]
        },
        {
            "id": "f03-open-po-per-store",
            "number": 3,
            "name": "Open PO per store",
            "logic": "Open PO × (store size ÷ total vertical store size) × (1 + inbound lever)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "open_po_total * (store_size / total_store_size) * (1 + inbound_lever / 100)",
            "parameters": [
                {
                    "key": "open_po_total",
                    "label": "Open PO, vertical total",
                    "type": "number",
                    "default": 25
                },
                {
                    "key": "store_size",
                    "label": "Store size index",
                    "type": "number",
                    "default": 1.2236
                },
                {
                    "key": "total_store_size",
                    "label": "Total vertical store size",
                    "type": "number",
                    "default": 20.8447
                },
                {
                    "key": "inbound_lever",
                    "label": "Inbound lever %",
                    "type": "number",
                    "default": 0
                }
            ]
        },
        {
            "id": "f04-position",
            "number": 4,
            "name": "Position",
            "logic": "ROUND(on-hand + open PO)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ROUND(on_hand + open_po)",
            "parameters": [
                {
                    "key": "on_hand",
                    "label": "On-hand units",
                    "type": "number",
                    "default": 66.793533
                },
                {
                    "key": "open_po",
                    "label": "Open PO units",
                    "type": "number",
                    "default": 1.467519
                }
            ]
        },
        {
            "id": "f05-rop",
            "number": 5,
            "name": "ROP",
            "logic": "ROUND(ADS × (lead + safety))",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ROUND(ads * (MAX(1, lead_time_days + lead_time_adjust) + MAX(0, safety_days + safety_adjust)))",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 29.166885
                },
                {
                    "key": "lead_time_days",
                    "label": "Lead time days",
                    "type": "number",
                    "default": 2
                },
                {
                    "key": "lead_time_adjust",
                    "label": "Lead time adjustment",
                    "type": "number",
                    "default": 0
                },
                {
                    "key": "safety_days",
                    "label": "Safety stock days",
                    "type": "number",
                    "default": 1
                },
                {
                    "key": "safety_adjust",
                    "label": "Safety days adjustment",
                    "type": "number",
                    "default": 0
                }
            ]
        },
        {
            "id": "f06-maximum-inventory",
            "number": 6,
            "name": "Maximum inventory",
            "logic": "ROUND(ADS × (lead + safety + hzCov)); hzCov = MAX(2, Horizon weeks / 2)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ROUND(ads * (MAX(1, lead_time_days + lead_time_adjust) + MAX(0, safety_days + safety_adjust) + horizon_coverage))",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 29.166885
                },
                {
                    "key": "lead_time_days",
                    "label": "Lead time days",
                    "type": "number",
                    "default": 2
                },
                {
                    "key": "lead_time_adjust",
                    "label": "Lead time adjustment",
                    "type": "number",
                    "default": 0
                },
                {
                    "key": "safety_days",
                    "label": "Safety stock days",
                    "type": "number",
                    "default": 1
                },
                {
                    "key": "safety_adjust",
                    "label": "Safety days adjustment",
                    "type": "number",
                    "default": 0
                },
                {
                    "key": "horizon_coverage",
                    "label": "Horizon coverage weeks (hzCov, Constants B24)",
                    "type": "number",
                    "default": 4
                }
            ]
        },
        {
            "id": "f07-inventory-state",
            "number": 7,
            "name": "Inventory state",
            "logic": "Stockout / Low / Expiry / Overstock / Slow-mover / Healthy classification",
            "sheet": "ENGINE_STORE",
            "result_type": "text",
            "expression": "IF(position < rop * 0.6, \"Stockout\", IF(position < rop, \"Low\", IF(AND(perishable = \"Y\", days_of_supply > shelf_life_days), \"Expiry\", IF(AND(perishable = \"N\", days_of_supply > 15), \"Overstock\", IF(AND(velocity < 1, days_of_supply > 10), \"Slow-mover\", \"Healthy\")))))",
            "parameters": [
                {
                    "key": "position",
                    "label": "Position units",
                    "type": "number",
                    "default": 26
                },
                {
                    "key": "rop",
                    "label": "Reorder point",
                    "type": "number",
                    "default": 44
                },
                {
                    "key": "days_of_supply",
                    "label": "Days of supply",
                    "type": "number",
                    "default": 1.775588
                },
                {
                    "key": "perishable",
                    "label": "Perishable (Y/N)",
                    "type": "text",
                    "default": "Y"
                },
                {
                    "key": "shelf_life_days",
                    "label": "Shelf life days",
                    "type": "number",
                    "default": 3
                },
                {
                    "key": "velocity",
                    "label": "Velocity index",
                    "type": "number",
                    "default": 1.1125
                }
            ]
        },
        {
            "id": "f08-forecast-7-days",
            "number": 8,
            "name": "Forecast 7 days",
            "logic": "ADS × 7.45 weighted-week factor",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ads * week_factor",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 29.166885
                },
                {
                    "key": "week_factor",
                    "label": "Weighted-week factor",
                    "type": "number",
                    "default": 7.45
                }
            ]
        },
        {
            "id": "f09-order-quantity-sales-units",
            "number": 9,
            "name": "Order quantity, sales units",
            "logic": "IF position < ROP, MAX(0, maximum − position)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(position < rop, MAX(0, max_inventory - position), 0)",
            "parameters": [
                {
                    "key": "position",
                    "label": "Position units",
                    "type": "number",
                    "default": 68
                },
                {
                    "key": "rop",
                    "label": "Reorder point",
                    "type": "number",
                    "default": 88
                },
                {
                    "key": "max_inventory",
                    "label": "Maximum inventory",
                    "type": "number",
                    "default": 204
                }
            ]
        },
        {
            "id": "f10-order-quantity-purchase-units",
            "number": 10,
            "name": "Order quantity, purchase units",
            "logic": "CEILING(order sales ÷ pack factor)",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(order_sales_units > 0, CEILING(order_sales_units / pack_factor, 1), 0)",
            "parameters": [
                {
                    "key": "order_sales_units",
                    "label": "Order quantity, sales units",
                    "type": "number",
                    "default": 136
                },
                {
                    "key": "pack_factor",
                    "label": "Pack factor",
                    "type": "number",
                    "default": 12
                }
            ]
        },
        {
            "id": "f11-order-value",
            "number": 11,
            "name": "Order value",
            "logic": "Order-buy × pack factor × price",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ROUND(order_buy_units * pack_factor * price)",
            "parameters": [
                {
                    "key": "order_buy_units",
                    "label": "Order quantity, purchase units",
                    "type": "number",
                    "default": 12
                },
                {
                    "key": "pack_factor",
                    "label": "Pack factor",
                    "type": "number",
                    "default": 12
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 18900
                }
            ]
        },
        {
            "id": "f12-at-risk-value",
            "number": 12,
            "name": "At-risk value",
            "logic": "IF state ≠ Healthy, position × price, otherwise 0",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(state <> \"Healthy\", position * price, 0)",
            "parameters": [
                {
                    "key": "state",
                    "label": "Inventory state",
                    "type": "text",
                    "default": "Low"
                },
                {
                    "key": "position",
                    "label": "Position units",
                    "type": "number",
                    "default": 68
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 18900
                }
            ]
        },
        {
            "id": "f13-incremental-promotion-margin",
            "number": 13,
            "name": "Incremental promotion margin",
            "logic": "Promo incremental revenue × (margin + 0.16) − promotional cost × 0.55",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(promo_eligible = \"Y\", ((ads * 7 * price) * (0.15 * 2.2 * (1 - cannibalization)) * 0.85) * (margin_pct + 0.16) - ((ads * 7 * price) * 0.15 * (1 - promo_funding)) * 0.55, 0)",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 19.636343
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 19100
                },
                {
                    "key": "margin_pct",
                    "label": "Margin %",
                    "type": "number",
                    "default": 0.1778
                },
                {
                    "key": "promo_funding",
                    "label": "Promo funding share",
                    "type": "number",
                    "default": 0.4862
                },
                {
                    "key": "cannibalization",
                    "label": "Cannibalization",
                    "type": "number",
                    "default": 0.1596
                },
                {
                    "key": "promo_eligible",
                    "label": "Promo eligible (Y/N)",
                    "type": "text",
                    "default": "Y"
                }
            ]
        },
        {
            "id": "f14-recoverable-at-risk-value",
            "number": 14,
            "name": "Recoverable at-risk value",
            "logic": "Gross exposure recovered after markdown depth and the sell-through that depth buys; depth scales with the markdown lever and caps at 65%",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(gross <= 0, 0, ROUND(gross * MIN(0.95, 0.35 + MAX(elasticity, 0 - elasticity) * (MIN(0.65, IF(state = \"Expiry\", 0.4, IF(state = \"Overstock\", 0.25, 0.3)) * (25 + markdown_lever) / 25)) * 1.15) * (1 - (MIN(0.65, IF(state = \"Expiry\", 0.4, IF(state = \"Overstock\", 0.25, 0.3)) * (25 + markdown_lever) / 25))), 0))",
            "parameters": [
                {
                    "key": "gross",
                    "label": "Markdown at-risk value (gross)",
                    "type": "number",
                    "default": 1394300
                },
                {
                    "key": "state",
                    "label": "Inventory state",
                    "type": "text",
                    "default": "Expiry"
                },
                {
                    "key": "elasticity",
                    "label": "Price elasticity",
                    "type": "number",
                    "default": -1.2489
                },
                {
                    "key": "markdown_lever",
                    "label": "Markdown depth % (Constants B18)",
                    "type": "number",
                    "default": 0
                }
            ]
        },
        {
            "id": "f15-contribution-per-day",
            "number": 15,
            "name": "Contribution per day",
            "logic": "ADS × price × margin %",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ROUND(ads * price * margin_pct)",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 29.166885
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 18900
                },
                {
                    "key": "margin_pct",
                    "label": "Margin %",
                    "type": "number",
                    "default": 0.2435
                }
            ]
        },
        {
            "id": "f16-labour-fte",
            "number": 16,
            "name": "Labour FTE",
            "logic": "ADS × 7 × price ÷ sales-per-FTE",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "ads * 7 * price / sales_per_fte",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 29.166885
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 18900
                },
                {
                    "key": "sales_per_fte",
                    "label": "Sales per FTE",
                    "type": "number",
                    "default": 6200000
                }
            ]
        },
        {
            "id": "f17-required-workforce",
            "number": 17,
            "name": "Required workforce",
            "logic": "MAX(1, ROUND(size × WF base × peak × (1 + event lift) × (0.80 + 0.17 × footfall index)))",
            "sheet": "Workforce",
            "result_type": "number",
            "expression": "MAX(1, ROUND(store_size * wf_base * peak_factor * (1 + event_lift) * (0.8 + 0.17 * footfall_index)))",
            "parameters": [
                {
                    "key": "store_size",
                    "label": "Store size index",
                    "type": "number",
                    "default": 1.0751
                },
                {
                    "key": "wf_base",
                    "label": "Workforce base",
                    "type": "number",
                    "default": 26
                },
                {
                    "key": "peak_factor",
                    "label": "Peak factor",
                    "type": "number",
                    "default": 1.22
                },
                {
                    "key": "event_lift",
                    "label": "Event lift",
                    "type": "number",
                    "default": 0.25
                },
                {
                    "key": "footfall_index",
                    "label": "Footfall index",
                    "type": "number",
                    "default": 1.085
                }
            ]
        },
        {
            "id": "f18-scheduled-workforce",
            "number": 18,
            "name": "Scheduled workforce",
            "logic": "ROUND(size × WF base × (0.99 + 0.16 × health))",
            "sheet": "Workforce",
            "result_type": "number",
            "expression": "ROUND(store_size * wf_base * (0.99 + 0.16 * store_health))",
            "parameters": [
                {
                    "key": "store_size",
                    "label": "Store size index",
                    "type": "number",
                    "default": 1.0751
                },
                {
                    "key": "wf_base",
                    "label": "Workforce base",
                    "type": "number",
                    "default": 26
                },
                {
                    "key": "store_health",
                    "label": "Store health index",
                    "type": "number",
                    "default": 0.8934
                }
            ]
        },
        {
            "id": "f19-coverage-gap",
            "number": 19,
            "name": "Coverage gap",
            "logic": "MAX(0, required − scheduled)",
            "sheet": "Workforce",
            "result_type": "number",
            "expression": "MAX(0, required - scheduled)",
            "parameters": [
                {
                    "key": "required",
                    "label": "Required workforce",
                    "type": "number",
                    "default": 42
                },
                {
                    "key": "scheduled",
                    "label": "Scheduled workforce",
                    "type": "number",
                    "default": 32
                }
            ]
        },
        {
            "id": "f20-days-of-supply",
            "number": 20,
            "name": "Days of supply",
            "logic": "Position / ADS, guarded against a dead SKU",
            "sheet": "ENGINE",
            "result_type": "number",
            "expression": "IF(ads > 0, position / ads, 0)",
            "parameters": [
                {
                    "key": "ads",
                    "label": "ADS, chain-net",
                    "type": "number",
                    "default": 496.869179208
                },
                {
                    "key": "position",
                    "label": "Position",
                    "type": "number",
                    "default": 1176
                }
            ]
        },
        {
            "id": "f21-inventory-value",
            "number": 21,
            "name": "Inventory value",
            "logic": "ROUND(position x price)",
            "sheet": "ENGINE",
            "result_type": "number",
            "expression": "ROUND(position * price)",
            "parameters": [
                {
                    "key": "position",
                    "label": "Position",
                    "type": "number",
                    "default": 1176
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 18900
                }
            ]
        },
        {
            "id": "f22-expiry-units",
            "number": 22,
            "name": "Expiry units",
            "logic": "Perishable stock already past its shelf-life cover",
            "sheet": "ENGINE",
            "result_type": "number",
            "expression": "IF(perishable = \"Y\", MAX(0, ROUND(position - ads * shelf_life_days, 0)), 0)",
            "parameters": [
                {
                    "key": "perishable",
                    "label": "Perishable (Y/N)",
                    "type": "text",
                    "default": "Y"
                },
                {
                    "key": "position",
                    "label": "Position",
                    "type": "number",
                    "default": 1176
                },
                {
                    "key": "ads",
                    "label": "ADS, chain-net",
                    "type": "number",
                    "default": 496.869179208
                },
                {
                    "key": "shelf_life_days",
                    "label": "Shelf life (days)",
                    "type": "number",
                    "default": 3
                }
            ]
        },
        {
            "id": "f23-markdown-at-risk-gross",
            "number": 23,
            "name": "Markdown at-risk value (gross)",
            "logic": "Expiry excess value; otherwise overstock/slow-mover excess or 30% fallback",
            "sheet": "ENGINE_STORE",
            "result_type": "number",
            "expression": "IF(state = \"Expiry\", MAX(0, position - ads * shelf_life_days) * price, IF(OR(state = \"Overstock\", state = \"Slow-mover\"), IF(MAX(0, position - max_inventory) > 0, (position - max_inventory) * price, position * 0.3 * price), 0))",
            "parameters": [
                {
                    "key": "state",
                    "label": "Inventory state",
                    "type": "text",
                    "default": "Expiry"
                },
                {
                    "key": "position",
                    "label": "Position units",
                    "type": "number",
                    "default": 110
                },
                {
                    "key": "ads",
                    "label": "ADS per store",
                    "type": "number",
                    "default": 23.460583
                },
                {
                    "key": "shelf_life_days",
                    "label": "Shelf life days",
                    "type": "number",
                    "default": 4
                },
                {
                    "key": "max_inventory",
                    "label": "Maximum inventory",
                    "type": "number",
                    "default": 164
                },
                {
                    "key": "price",
                    "label": "Unit price",
                    "type": "number",
                    "default": 19100
                }
            ]
        }
    ]
}
