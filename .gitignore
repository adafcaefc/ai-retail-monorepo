# OS files
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
# Build configuration, not a secret: it holds one flag, and without it
# `npm run build:standalone` silently produces an API build on a fresh clone.
!frontend/.env.standalone

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Excel source data
data/*.xlsx
data/*.xls

# Excel lock files, written next to a workbook while it is open
~$*.xlsx
~$*.xls

# Generated import files
data/import_logs/
data/import_preview/

# Generated Retail 360 inspection and semantic preview artifacts
/generated/

# Temporary workspace
/tmp/*
!/tmp/.gitkeep
