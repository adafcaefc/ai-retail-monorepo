# Loaded by `vite build --mode standalone` (npm run build:standalone).
#
# Pins the Retail boards to their checked-in fixtures, so the single HTML file
# vite-plugin-singlefile emits opens with no server behind it. See
# src/agents/retail/common/dataSource.js for what the two values mean and why
# this is a build flag rather than a control on screen.
#
# The default build has no VITE_DATA_SOURCE and therefore talks to the API.
VITE_DATA_SOURCE=fixture
