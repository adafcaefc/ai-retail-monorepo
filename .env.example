# Copy to .env and fill in values before running locally.
# Required for the backend to start and for agents to call Azure OpenAI.

# PostgreSQL connection string (SQLAlchemy + psycopg)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_finance_forum

# Azure OpenAI — at least one of API_BASE or ENDPOINT is required
AZURE_OPENAI_API_BASE=https://your-resource.openai.azure.com
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# HTTP server port (default: 8000)
# PORT=8000

# Teams webhook authentication for /api/finance-agents/* endpoints.
# If unset, header verification is disabled (local dev only).
# TEAMS_WEBHOOK_SECRET=your-shared-secret

# Used by integration tests and simulation pipeline Teams notifications.
# Not required for normal local development.
# TEAMS_POWER_AUTOMATE_WEBHOOK_URL=https://your-logic-app-trigger-url
