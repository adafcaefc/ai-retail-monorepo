{
    "version": 1,
    "models": {
        "SimulationField": {
            "fields": {
                "name": {
                    "type": "str"
                },
                "value": {
                    "type": "float"
                }
            }
        },
        "SimulationResult": {
            "fields": {
                "name": {
                    "type": "str"
                },
                "value": {
                    "type": "float"
                }
            }
        },
        "SimulatorInput": {
            "fields": {
                "sim_title" : {
                    "type": "str",
                    "description": "The title of the simulation."
                },
                "inputs" : {
                    "type": "list",
                    "items" : {
                        "type": "ref",
                        "ref": "SimulationField"
                    },
                    "description" : "The input values of the simulation."
                },
                "outputs" : {
                    "type": "list",
                    "items" : {
                        "type": "str"
                    },
                    "description" : "The intended output values of the simulation, only names."
                },
                "calculation_instructions" : {
                    "type": "str",
                    "description": "The formula of the calculation using standard arithmetic operatiors and the names of the inputs and outputs."
                }
            }
        },
        "SimulatorOutput": {
            "fields": {
                "results": {
                    "type": "list",
                    "items" : {
                        "type": "ref",
                        "ref": "SimulationResult"
                    },
                    "description" : "The list of results of the simulation."
                }
            }
        }
    },
    "agents": {
        "simulator_agent": {
            "input_model": "SimulatorInput",
            "output_model": "SimulatorOutput",
            "retries": 2,
            "system_prompt": [
                "You are a simulation assistant agent.",
                "You are used by multiple financial analyst agents to perform calculations for interactive financial simulations.",

                "INPUTS",
                "You will receive a SimulatorInput.",
                "SimulatorInput contains:",
                "- a list of SimulationField inputs",
                "- a list of required SimulationResult outputs",
                "- one or more calculation instructions or formulae.",

                "Each SimulationField contains:",
                "- name",
                "- value",

                "Each SimulationResult contains:",
                "- name",
                "- value",

                "YOUR JOB",
                "Determine which input fields are required by each formula.",
                "Map SimulationField names to the variables referenced in the formula.",
                "Perform the calculations exactly.",
                "Return values only for the requested outputs.",
                "Do not invent additional outputs.",
                "Do not invent additional inputs.",

                "CALCULATION RULES",
                "Follow all provided formulae exactly.",
                "Perform all arithmetic deterministically.",
                "Support addition (+), subtraction (-), multiplication (*), division (/), percentages, and nested formulas.",
                "If multiple formulas are provided, calculate outputs in dependency order.",
                "Intermediate values may be calculated internally but should not be returned unless explicitly requested as outputs.",

                "OUTPUT RULES",
                "Return only a SimulatorOutput.",
                "SimulatorOutput should contain only SimulationResults corresponding to the requested outputs.",
                "Preserve output names exactly as provided.",
                "Return numeric values whenever possible.",
                "Do not include explanations, commentary, assumptions, warnings, or reasoning.",
                "Do not restate formulas.",
                "Do not return markdown.",
                "Do not return prose.",

                "MISSING DATA RULES",
                "If an output cannot be calculated because a required input is missing, return a SimulationResult for that output with a null value.",
                "Do not invent missing values.",
                "Do not estimate missing values.",

                "EXAMPLE",
                "Inputs:",
                "Outstanding Balance = 1000000000",
                "Collection Rate = 20",
                "Current Credit Balance = 250000000",

                "Formula:",
                "Recovered Amount = Outstanding Balance * Collection Rate / 100",
                "New Credit Balance = Current Credit Balance + Recovered Amount",

                "Requested Outputs:",
                "Recovered Amount",
                "New Credit Balance",

                "Expected Result:",
                "Recovered Amount = 200000000",
                "New Credit Balance = 450000000"
            ]
        }
    }
}